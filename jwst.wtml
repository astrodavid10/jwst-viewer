  <Place Angle="0" AngularSize="0" Constellation="CEN" DataSetType="Sky" Dec="-43.018826715934765" Magnitude="0" Name="Centaurus A (NIRCam image)" Opacity="100" RA="13.424346843075467" Rotation="0" Thumbnail="https://data1.wwtassets.org/feeds/jwst/weic2615e/thumb.jpg" ZoomLevel="1.5456946598574786">
    <Description>This view of Centaurus A from the NASA/ESA/CSA James Webb Space Telescope if from the Near-Infrared Camera (NIRCam) Webb’s infrared vision exposes a warped disk of gas and dust left behind by a collision with another galaxy billions of years ago.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.2843020648195478" BaseTileLevel="0" BottomsUp="False" CenterX="201.36520444228336" CenterY="-43.01883270874455" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Centaurus A (NIRCam image)" OffsetX="4.338105237114682e-06" OffsetY="4.338105237114682e-06" Projection="Tan" QuadTreeMap="" Rotation="32.64000000000007" Sparse="True" StockSet="False" TileLevels="7" Url="https://data1.wwtassets.org/feeds/jwst/weic2615e/L{1}X{2}Y{3}.png" WidthFactor="2">
