  </Place>
  <Place Angle="0" AngularSize="0" Constellation="IND" DataSetType="Sky" Dec="-56.802620620962514" Magnitude="0" Name="Exoplanet Epsilon Indi Ab (MIRI image)" Opacity="100" RA="22.059165965766304" Rotation="0" Thumbnail="https://data1.wwtassets.org/feeds/jwst/weic2421a/thumb.jpg" ZoomLevel="0.052254795808675786">
    <Description>This image of the gas-giant exoplanet Epsilon Indi Ab was taken with the coronagraph on the NASA/ESA/CSA James Webb Space Telescope’s MIRI (Mid-Infrared Instrument). A star symbol marks the location of the host star Epsilon Indi A, whose light has been blocked by the coronagraph, resulting in the dark circle marked with a dashed white line. Epsilon Indi Ab is one of the coldest exoplanets ever directly imaged. Light at 10.6 microns was assigned the color blue, while light at 15.5 microns was assigned the color orange. MIRI did not resolve the planet, which is a point source. [Image description: This image shows the exoplanet Epsilon Indi Ab. Blue scale-like features are visible in the background, with the host star’s light being blocked by a black circle in the centre of the image (indicated by a dashed-line and white star visual overlaid on the image). The exoplanet is visible on the left as a bright orange circle.]</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.009714762328991287" BaseTileLevel="0" BottomsUp="False" CenterX="330.8874921984947" CenterY="-56.80261984137904" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Exoplanet Epsilon Indi Ab (MIRI image)" OffsetX="1.1858840733631943e-06" OffsetY="1.1858840733631943e-06" Projection="Tan" QuadTreeMap="" Rotation="-72.6999999999999" Sparse="True" StockSet="False" TileLevels="4" Url="https://data1.wwtassets.org/feeds/jwst/weic2421a/L{1}X{2}Y{3}.png" WidthFactor="2">
