  <Place Angle="0" AngularSize="0" Constellation="DEL" DataSetType="Sky" Dec="17.128055076046593" Magnitude="0" Name="Galactic Get-Together (JWST)" Opacity="100" RA="20.95679422280273" Rotation="0" Thumbnail="https://data1.wwtassets.org/packages/2022/12_jwst/potm2211b/thumb.jpg" ZoomLevel="0.28494381908080607">
