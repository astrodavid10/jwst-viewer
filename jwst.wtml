      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.07021377800567315" BaseTileLevel="0" BottomsUp="False" CenterX="199.71051447552" CenterY="-21.034064288379" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 5068 (JWST MIRI)" OffsetX="4.285508911479074e-06" Projection="Tan" QuadTreeMap="" Rotation="37.540000000000035" Sparse="True" StockSet="False" TileLevels="5" Url="https://data1.wwtassets.org/packages/2023/06_jwst/potm2305e/{1}/{3}/{3}_{2}.png" WidthFactor="2" Xcxstatus="in:653a6c89dba86d239b27cddc">
