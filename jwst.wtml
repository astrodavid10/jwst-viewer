        <Credits>ESA/Webb, NASA &amp; CSA, A. Leroy</Credits>
        <CreditsUrl>https://esawebb.org/images/potm2604c/</CreditsUrl>
        <ThumbnailUrl>https://data1.wwtassets.org/feeds/jwst/potm2604c/thumb.jpg</ThumbnailUrl>
      </ImageSet>
