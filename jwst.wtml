      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.035817662485297906" BaseTileLevel="0" BottomsUp="False" CenterX="188.58407675057" CenterY="8.1968134487863" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 4535" OffsetX="1.7489093010399368e-05" Projection="Tan" QuadTreeMap="" Rotation="17.375858627041268" Sparse="True" StockSet="False" TileLevels="3" Url="https://data1.wwtassets.org/packages/2024/01_jwst/weic2403r/{1}/{3}/{3}_{2}.png" WidthFactor="2" Xcxstatus="in:65bdbc96e1238e3fe35f5fa8">
